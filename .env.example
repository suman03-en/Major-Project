# Standard OpenAI-compatible LLM configuration (works with any provider)
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your_api_key_here"
LLM_MODEL="openai/gpt-oss-120b"

# Optional lighter/separate-TPM model for translation and retrieval planning:
# LLM_HELPER_MODEL="llama-3.1-8b-instant"

# Optional JSON array of fallback endpoints tried in order on rate-limit / error:
# LLM_FALLBACKS='[{"base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"...","model":"gemini-2.5-flash"}]'

# Tiered TPM budget & retry controls (defaults tuned for free tier; raise on paid tier)
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=2.0
LLM_RETRY_MAX_WAIT_SECONDS=60.0
MAX_CONTEXT_TOKENS=3500
MAX_SIBLINGS_PER_SECTION=2
AGENT_MAX_LOOPS=2
AGENT_MAX_PROVISIONS=8

QDRANT_URL="http://qdrant:6333"
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"


# Web API runtime controls
ENABLE_RERANK=false
USE_GRAPH=false

