MISTRAL_API_KEY="your_mistral_api_key_here"
QDRANT_URL="http://qdrant:6333"
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"


# Pipeline execution controls (set to true to enable)
RUN_EXTRACT=false
RUN_INGEST=false
RECREATE_COLLECTION=false

# Cross-encoder reranking control (set false to disable BAAI/bge-reranker-v2-m3 and save CPU/memory)
ENABLE_RERANK=false

