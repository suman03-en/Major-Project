# Standard OpenAI-compatible LLM configuration (works with any provider)
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your_api_key_here"
LLM_MODEL="openai/gpt-oss-120b"

# Optional JSON array of fallback endpoints tried in order on rate-limit / error:
# LLM_FALLBACKS='[{"base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"...","model":"gemini-2.5-flash"}]'

QDRANT_URL="http://qdrant:6333"
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"


# Web API runtime controls
ENABLE_RERANK=false
USE_GRAPH=false

