# Standard OpenAI-compatible LLM configuration (works with any provider)
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your_api_key_here"
LLM_MODEL="openai/gpt-oss-120b"

# Optional lighter/separate-TPM model for translation and retrieval planning:
# LLM_HELPER_MODEL="llama-3.1-8b-instant"

# Optional JSON array of fallback endpoints tried in order on rate-limit / error
# (base_url and api_key are optional and default to LLM_BASE_URL / LLM_API_KEY):
# LLM_FALLBACKS='[{"model":"gemini-3.1-flash-lite"},{"model":"gemini-3.6-flash"}]'

# Tiered TPM budget & retry controls (defaults tuned for Groq 8k TPM free tier)
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=2.0
LLM_RETRY_MAX_WAIT_SECONDS=60.0
MAX_CONTEXT_TOKENS=3500
MAX_SIBLINGS_PER_SECTION=2
AGENT_MAX_LOOPS=2
AGENT_MAX_PROVISIONS=8

# Google Gemini free-tier preset (15 RPM, 250k TPM, 500 RPD):
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# LLM_MODEL="gemini-3.5-flash-lite"
# LLM_HELPER_MODEL="gemini-3.1-flash-lite"
# LLM_FALLBACKS='[{"model":"gemini-3.1-flash-lite"},{"model":"gemini-3.6-flash"}]'
# MAX_CONTEXT_TOKENS=10000
# MAX_SIBLINGS_PER_SECTION=4
# AGENT_MAX_PROVISIONS=12

QDRANT_URL="http://qdrant:6333"
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"


# Web API runtime controls
ENABLE_RERANK=false
USE_GRAPH=false

